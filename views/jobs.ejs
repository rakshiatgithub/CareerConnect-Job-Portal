
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Available Jobs | CareerConnect</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="container" style="max-width: 800px;">
    <h1>CareerConnect</h1>
    <h2>Available Jobs</h2>

    <% if (user && user.role === "recruiter") { %>
      <p><a href="/jobs/new">+ Post a Job</a></p>
      <p><a href="/recruiter/applications">View Applicants</a></p>
    <% } %>

    <% if (user && user.role === "candidate") { %>
      <p><a href="/my-applications">My Applications</a></p>
    <% } %>

    <% if (jobs.length === 0) { %>
      <p>No jobs posted yet.</p>
    <% } %>

    <% jobs.forEach(job => { %>
      <div style="border: 1px solid #ddd; padding: 18px; margin-top: 16px; border-radius: 8px;">
        <h3><%= job.title %></h3>
        <p><strong>Company:</strong> <%= job.company %></p>
        <p><strong>Location:</strong> <%= job.location %></p>
        <p><strong>Salary:</strong> <%= job.salary %></p>
        <p><%= job.description %></p>

        <% if (user && user.role === "candidate") { %>
          <form action="/jobs/<%= job._id %>/apply" method="POST">
            <button type="submit">Apply Now</button>
          </form>
        <% } %>

        <% if (user && user.role === "recruiter" &&
              job.recruiter &&
              job.recruiter._id.toString() === user.id) { %>
          <p><a href="/jobs/<%= job._id %>/edit">Edit Job</a></p>
          <form action="/jobs/<%= job._id %>/delete" method="POST">
            <button type="submit">Delete Job</button>
          </form>
        <% } %>
      </div>
    <% }) %>
  </div>
</body>
</html>
